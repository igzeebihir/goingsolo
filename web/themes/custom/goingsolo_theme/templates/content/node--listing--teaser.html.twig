{#
/**
 * @file
 * Solo deal card with a county "postcard" header.
 */
#}
<article{{ attributes.addClass('deal-card', node.field_featured.value ? 'deal-card--featured') }}>
  <a class="deal-card__postcard deal-card__postcard--{{ gs_province|default('ireland')|clean_class }}" href="{{ url }}" tabindex="-1" aria-hidden="true">
    {% if content.field_image|render|striptags('<img>')|trim %}
      {{ content.field_image }}
    {% else %}
      <span class="deal-card__county">{{ gs_county ? 'Co. @county'|t({'@county': gs_county}) : 'Ireland'|t }}</span>
      {% if gs_town and gs_town != gs_county %}<span class="deal-card__town">{{ gs_town }}</span>{% endif %}
    {% endif %}
  </a>
  <div class="deal-card__body">
    {% if gs_badges %}
      <ul class="deal-card__badges">
        {% for badge in gs_badges %}
          <li class="gs-badge gs-badge--{{ badge.modifier }}">{{ badge.label }}</li>
        {% endfor %}
      </ul>
    {% endif %}
    {{ title_prefix }}
    <h3{{ title_attributes.addClass('deal-card__title') }}>
      <a href="{{ url }}" rel="bookmark">{{ label }}</a>
    </h3>
    {{ title_suffix }}
    <p class="deal-card__where">{{ gs_type }}{% if gs_provider %} · {{ gs_provider }}{% endif %}</p>
    <div class="deal-card__summary">{{ content.body }}</div>
    <div class="deal-card__foot">
      <div class="deal-card__price">
        {% if gs_price %}
          <span class="deal-card__from">{{ 'from'|t }}</span>
          <span class="deal-card__amount">{{ gs_price }}</span>
          {% if gs_price_basis %}<span class="deal-card__basis">{{ gs_price_basis }}</span>{% endif %}
        {% elseif gs_price_basis %}
          <span class="deal-card__ask">{{ gs_price_basis }}</span>
        {% else %}
          <span class="deal-card__ask">{{ 'Price on request'|t }}</span>
        {% endif %}
      </div>
      <a class="deal-card__more" href="{{ url }}" aria-label="{{ 'See the deal: @title'|t({'@title': node.label}) }}">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"/></svg>
      </a>
    </div>
  </div>
</article>
