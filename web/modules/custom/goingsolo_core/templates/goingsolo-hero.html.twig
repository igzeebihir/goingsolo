{#
/**
 * @file
 * Homepage hero with the county map.
 */
#}
<section class="gs-hero">
  <div class="gs-container gs-hero__grid">
    <div class="gs-hero__text">
      <p class="gs-hero__eyebrow"><span lang="ga">Ar do chonlán féin</span> · {{ 'on your own terms'|t }}</p>
      <h1 class="gs-hero__title">{{ 'Ireland,'|t }} <em>{{ 'for one.'|t }}</em></h1>
      <p class="gs-hero__lead">{{ 'Hotels, B&Bs and tours across the island with solo rates or no single supplement. Every deal is checked by a person and kept up to date.'|t }}</p>
      <div class="gs-hero__actions">
        <a class="button button--primary" href="{{ deals_url }}">{{ 'Browse solo deals'|t }}</a>
        <a class="button button--ghost" href="{{ guides_url }}">{{ 'Read the guides'|t }}</a>
      </div>
      {% if stats %}
        <ul class="gs-hero__stats">
          {% for stat in stats %}
            <li><strong>{{ stat.value }}</strong> {{ stat.label }}</li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
    {% if map %}
      <div class="gs-hero__map">
        <p class="gs-hero__map-label">{{ 'Tap a county to see its deals'|t }}</p>
        {{ map }}
      </div>
    {% endif %}
  </div>
</section>
